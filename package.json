{
  "name": "@lambdulus/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@lambdulus/core": "git+https://github.com/lambdulus/core.git#v0.0.9",
    "@monaco-editor/react": "^4.7.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "github-markdown-css": "^5.0.0",
    "jsdom": "^24.1.3",
    "monaco-editor": "^0.56.0",
    "pretty-checkbox": "^3.0.3",
    "pretty-checkbox-react": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^7.1.0",
    "typescript": "^5.4.5",
    "vite": "^6.0.11"
  },
  "scripts": {
    "start": "export VITE_VERSION_INFO=$(date +\"%m-%d-%y-%T\") VITE_COMMIT=$(git rev-parse HEAD) && vite",
    "build": "export VITE_VERSION_INFO=$(date +\"%m-%d-%y-%T\") VITE_COMMIT=$(git rev-parse HEAD) && tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "dompurify": "^3.4.14"
  }
}
